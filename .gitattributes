# Default: normalize text files; leave binaries alone.
* text=auto

# Shell scripts
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Source code
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.woff binary
*.woff2 binary
